{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } }
  },
  "Jwt": {
    "Issuer": "http://localhost:5001",
    "Audience": "nexconvo-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "LockoutMaxAttempts": 5,
    "LockoutWindowMinutes": 15,
    "RefreshReuseGraceSeconds": 60
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=nexconvo_identity;Username=nexconvo_service;Password=localdev_service_pw"
  },
  "Email": {
    "Default": {
      "Provider": "Smtp",
      "FromName": "NexConvo",
      "FromAddress": "no-reply@nexconvo.local",
      "Smtp": { "Host": "localhost", "Port": 1025, "UseSsl": false }
    }
  },
  "App": {
    "BaseUrl": "http://localhost:3003"
  },
  "Seq": { "Url": "http://localhost:5341" },
  "Otel": { "Endpoint": "" }
}
