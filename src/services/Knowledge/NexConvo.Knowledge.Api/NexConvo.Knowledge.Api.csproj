<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexConvo.Knowledge.Application\NexConvo.Knowledge.Application.csproj" />
    <ProjectReference Include="..\NexConvo.Knowledge.Infrastructure\NexConvo.Knowledge.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Both" (not just Server) so integration tests referencing this assembly get the typed
         KnowledgeRetrievalClient for free instead of re-generating the proto and colliding on
         the message types. -->
    <Protobuf Include="Protos\knowledge.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexConvo.Knowledge.IntegrationTests" />
  </ItemGroup>

</Project>
