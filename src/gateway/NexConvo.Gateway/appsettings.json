{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5001",
    "Audience": "nexconvo-api"
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Otel": {
    "Endpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-settings-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/settings/{**catch-all}" }
      },
      "identity-invitations-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/invitations/{**catch-all}" }
      },
      "identity-roles-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/roles/{**catch-all}" }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "identity-account-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/account/{**catch-all}" }
      },
      "crm-route": {
        "ClusterId": "crm-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/crm/{**catch-all}" }
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "chat-channel-connections-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/channel-connections/{**catch-all}" }
      },
      "chat-channel-connections-root-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/channel-connections" }
      },
      "chat-settings-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/chat-settings" }
      },
      "knowledge-route": {
        "ClusterId": "knowledge-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/knowledge-documents/{**catch-all}" }
      },
      "knowledge-root-route": {
        "ClusterId": "knowledge-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/knowledge-documents" }
      },
      "integrations-ai-route": {
        "ClusterId": "integrations-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/ai-config/{**catch-all}" }
      },
      "integrations-ai-root-route": {
        "ClusterId": "integrations-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/ai-config" }
      },
      "integrations-s3-route": {
        "ClusterId": "integrations-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/s3-config/{**catch-all}" }
      },
      "integrations-s3-root-route": {
        "ClusterId": "integrations-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/s3-config" }
      },
      "identity-swagger-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/swagger-json/identity/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "crm-swagger-route": {
        "ClusterId": "crm-cluster",
        "Match": { "Path": "/swagger-json/corecrm/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "chat-swagger-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/swagger-json/chat/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "integrations-swagger-route": {
        "ClusterId": "integrations-cluster",
        "Match": { "Path": "/swagger-json/integrations/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "knowledge-swagger-route": {
        "ClusterId": "knowledge-cluster",
        "Match": { "Path": "/swagger-json/knowledge/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "voice-swagger-route": {
        "ClusterId": "voice-cluster",
        "Match": { "Path": "/swagger-json/voice/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "aiassistant-swagger-route": {
        "ClusterId": "aiassistant-cluster",
        "Match": { "Path": "/swagger-json/aiassistant/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "automation-swagger-route": {
        "ClusterId": "automation-cluster",
        "Match": { "Path": "/swagger-json/automation/{**catch-all}" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "primary": { "Address": "http://identity:8080" }
        }
      },
      "crm-cluster": {
        "Destinations": {
          "primary": { "Address": "http://corecrm:8080" }
        }
      },
      "chat-cluster": {
        "Destinations": {
          "primary": { "Address": "http://chat:8080" }
        }
      },
      "integrations-cluster": {
        "Destinations": {
          "primary": { "Address": "http://integrations:8080" }
        }
      },
      "knowledge-cluster": {
        "Destinations": {
          "primary": { "Address": "http://knowledge:8080" }
        }
      },
      "voice-cluster": {
        "Destinations": {
          "primary": { "Address": "http://voice:8080" }
        }
      },
      "aiassistant-cluster": {
        "Destinations": {
          "primary": { "Address": "http://aiassistant:8080" }
        }
      },
      "automation-cluster": {
        "Destinations": {
          "primary": { "Address": "http://automation:8080" }
        }
      }
    }
  }
}
