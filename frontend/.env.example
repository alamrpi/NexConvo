# NexConvo frontend environment.
# Only NEXT_PUBLIC_* values are exposed to the browser bundle (frontend standard S13).
# Secrets (gateway URL, API keys) stay server-only — never prefix them with NEXT_PUBLIC_.

# --- Public (safe to expose) ---
NEXT_PUBLIC_APP_NAME=NexConvo
# Dev server is pinned to port 3003 (see package.json) to avoid clashing with other local projects.
NEXT_PUBLIC_APP_URL=http://localhost:3003
# Public origin that serves the embeddable chat-widget bundle (used to build the embed snippet).
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173

# --- Server-only (never sent to the client) ---
# The YARP API gateway base. Used only by server components / BFF route handlers.
API_GATEWAY_URL=http://localhost:8080
