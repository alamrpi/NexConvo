# Copy to .env (gitignored) and fill in. These are LOCAL-DEV values only.
# Production secrets come from Key Vault / K8s secrets, never a committed file (skill Standard 13).

POSTGRES_USER=nexconvo
POSTGRES_PASSWORD=localdev_pg_pw

# Password for the non-superuser `nexconvo_service` login the services connect with
# (created by infra/postgres/init/01-databases.sql). Keep in sync with that script.
POSTGRES_SERVICE_PASSWORD=localdev_service_pw

REDIS_PASSWORD=localdev_redis_pw

RABBITMQ_USER=nexconvo
RABBITMQ_PASSWORD=localdev_rabbitmq_pw
